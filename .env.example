# ============================================================
# 环境变量示例。请复制为 .env 后再修改：
#   cp .env.example .env
# 或者直接运行自动生成（推荐，会填好随机密钥）：
#   ./scripts/gen-env.sh
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=app
# ⚠️ 必填：不要使用 app / 123456 这类弱口令
POSTGRES_PASSWORD=
POSTGRES_DB=notes

# ---------- 后端 ----------
# ⚠️ 必填：JWT 签名密钥（至少 16 字符，建议 32+）
#    生成方式：openssl rand -base64 48
JWT_SECRET=
# Token 有效期（默认 7 天）
JWT_EXPIRES_IN=7d
# 日历订阅链接（iCal）的有效期天数，默认 90。
# 过期后在「提醒设置」页重新获取一次订阅地址即可。
ICAL_TOKEN_TTL_DAYS=90
# 时区：提醒/汇总按本地时间触发，务必设置
TZ=Asia/Shanghai
# 信任哪些反向代理地址（用于正确取到真实客户端 IP，限流依赖它）。
# 留空 = 默认只信任私网段（127.0.0.1,::1,10/8,172.16/12,192.168/16），Docker Compose 部署无需修改。
# 也可写逗号分隔的 IP/CIDR 白名单；写 true 表示信任任意来源（仅在确认后端不可能被直连时使用）。
# ⚠️ 不要无脑写 true：那等于允许任何人伪造 X-Forwarded-For 绕过登录限流。
TRUST_PROXY=

# ---------- 访问端口 ----------
# Nginx 对外暴露的端口（宿主机）。飞牛 NAS 的 80/443 常被系统门户占用，
# 因此默认用 8080；远程访问建议再套 Cloudflare Tunnel 指向 localhost:8080
APP_PORT=8080

# ---------- CORS ----------
# 默认留空 = 不开放跨域（同源部署 / Nginx 反代场景不需要）。
# 仅当前后端确实分离部署时填写，多个用英文逗号分隔：
#   CORS_ORIGIN=https://notes.example.com,http://192.168.1.10:5173
CORS_ORIGIN=

# ---------- SMTP 邮件（提醒功能使用，可留空 = LOG 模式） ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- AI 周总结 ----------
# LLM API Key 的加密密钥（AES-256-GCM，32 字符）。
# 留空时会从 JWT_SECRET 派生，零配置可用；但**显式配置更稳妥**：
#   生成方式：openssl rand -base64 32
# ⚠️ 一旦配置并保存过 LLM API Key，就不要更换本值，否则已加密的 Key 无法解密、需重新配置。
#    （同理，若留空走 JWT_SECRET 派生，轮换 JWT_SECRET 也会导致已存 Key 失效。）
LLM_ENCRYPTION_KEY=

# ---------- 附件上传目录（容器内路径，docker-compose 已挂载卷） ----------
UPLOAD_DIR=/app/uploads

# ---------- 初始化管理员（npm run seed） ----------
# 不填 SEED_ADMIN_PASSWORD 时会随机生成一个强密码并打印一次
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=管理员
SEED_WORKSPACE_NAME=默认团队

# ---------- 备份 ----------
# BACKUP_DIR=./backups
# KEEP_COUNT=10
