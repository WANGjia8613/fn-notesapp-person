generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== M1 核心表 ==========

model Workspace {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  users       User[]
  notes       Note[]
  invitations Invitation[]
  reminders   Reminder[]
  attachments Attachment[]
  llmConfig   LlmConfig?
}

model User {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         String    @default("member") // owner / admin / member
  createdAt    DateTime  @default(now())
  notes        Note[]
  attachments  Attachment[]
  noteShares   NoteMember[]
  // 下列三张表原先的 userId 是裸 String（无外键），删用户会留下孤儿数据，
  // 这里补上关系并级联删除。
  reminders    Reminder[]
  summaryConfigs SummaryConfig[]
  webhookConfigs WebhookConfig[]
  aiSummaryConfig AiSummaryConfig?

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Note {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  /// 这里**故意**不写 onDelete: Cascade（数据库侧即默认的 ON DELETE RESTRICT）。
  ///
  /// 原因：笔记是核心资产。若级联删除，移除一个写了几十篇笔记的成员，
  /// 会把这些笔记一起带走 —— 对团队是灾难性的数据丢失。
  ///
  /// 真正的「移除成员」应当走软删除（禁用登录、保留数据）或先把其笔记移交给他人，
  /// 而不是物理删除 user 行。当前代码没有任何删除用户的入口，
  /// 因此这条外键不会触发；将来若要加移除成员功能，请先决定数据归属再动这里。
  author      User      @relation(fields: [authorId], references: [id])
  title       String
  bodyMd      String    @default("")
  // ===== 富文本正文（Markdown 与富文本双格式共存）=====
  // 正文格式标记：markdown = 存量笔记，走 react-markdown + Mermaid 渲染路径（原样保留）；
  // html = 新笔记，走 TipTap 富文本路径。前端按本字段分派渲染器。
  // 存量行的默认值 'markdown' 恰好就是它们的正确语义，因此无需回填。
  bodyFormat  String    @default("markdown")
  // ProseMirror JSON，富文本笔记的**编辑真源**。只有 bodyFormat='html' 时非空。
  // 不只存 HTML 的原因：HTML 无法表达列表层级/标题层级，所见即所得编辑器重开后会丢结构。
  bodyJson    String    @default("")
  // 由 bodyJson 同步派生的 HTML 冗余投影，供搜索 / iCal DESCRIPTION / 未来导出与邮件使用。
  // 不作为渲染真源，允许随时从 bodyJson 重新生成。
  bodyHtml    String    @default("")
  // bodyHtml（markdown 笔记则为 bodyMd）的纯文本投影，**仅用于搜索**。
  // 直接对 HTML 做 ILIKE 会被标签打断：搜中文因标签插入而失效，搜 div/span 会命中每一篇。
  // 由后端从正文派生，不接受前端传入（防投毒）。走 GIN trigram 索引。
  bodyText    String    @default("")
  tags        String[]  @default([])
  dueAt       DateTime? // 到期时间（侧边栏字段）
  remindAt    DateTime? // 提醒时间（侧边栏字段，M2 生效）
  isPrivate   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reminders   Reminder[]
  attachments Attachment[]
  members     NoteMember[]

  @@index([workspaceId])
  @@index([dueAt])
  // 提醒引擎每分钟按 remindAt 扫描，缺索引会退化成全表扫
  @@index([remindAt])
}

/// 私有笔记的共享成员（公开笔记不需要该表记录）
model NoteMember {
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([noteId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String?
  token       String    @unique
  expiresAt   DateTime
  usedBy      String?
  status      String    @default("pending") // pending / used / expired
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// ========== M2 提醒相关表 ==========

model Reminder {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  noteId      String?
  note        Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId      String?   // 接收者用户 ID
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // "due"（到期提醒） / "remind"（提前提醒） / "summary"（汇总推送）
  title       String
  body        String
  triggerAt   DateTime  // 计划触发时间
  channel     String    @default("email") // email / webhook
  status      String    @default("pending") // pending / sent / failed
  // 失败重试计数：达到上限后停止重试，避免 SMTP 故障时无限刷邮件/刷表
  attemptCount Int      @default(0)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([workspaceId])
  @@index([status, triggerAt])
  // 同一笔记的同一类提醒、同一触发时间只允许一条，
  // 由数据库层面兜住提醒引擎的去重，避免并发 tick 产生重复记录。
  // 注意：改期会产生新的 triggerAt，因此是一条新记录（旧记录会被引擎作废）。
  @@unique([noteId, userId, type, triggerAt])
}

model SummaryConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  frequency String   // "daily" / "weekly"
  time      String   // "09:00"（24小时制）
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, frequency])
}

model SendLog {
  id         String    @id @default(cuid())
  reminderId String?
  summaryKey String?   // 汇总幂等键，如 "daily:2026-10-05:user123"
  sentAt     DateTime  @default(now())
  status     String    // "sent" / "failed"
  detail     String?

  @@index([reminderId])
  @@index([summaryKey])

  // 幂等：同一个提醒 / 同一个汇总周期只允许一条 "sent" 记录
  @@unique([reminderId, status])
  @@unique([summaryKey, status])
}

model WebhookConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // 备注名，如"飞书群机器人"
  url       String
  type      String   @default("feishu") // feishu / dingtalk / wecom / generic
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ========== M4 AI 每周总结 ==========

// LLM 配置（workspace 级，由 owner/admin 配置，所有成员共用）。
// apiKey 加密存储（AES-256-GCM），不明文落库，前端永远拿不到明文。
// 一个 workspace 只允许一条配置（@@unique([workspaceId])）。
// enabled 是 workspace 级总开关：owner 关闭后所有成员 AI 总结立即停止，
// 但成员各自的 AiSummaryConfig 保留，重新开启后自动恢复。
// 采用 OpenAI 兼容接口（/chat/completions），覆盖 OpenAI / DeepSeek / 通义千问 /
// Kimi / 智谱 GLM / 本地 Ollama 等绝大多数服务商。
model LlmConfig {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider          String    @default("custom") // openai / deepseek / qwen / kimi / glm / ollama / custom
  baseUrl           String    // 如 https://api.openai.com/v1
  apiKeyEncrypted   String    // AES-256-GCM 加密后的 API Key
  model             String    // 模型名，如 gpt-4o-mini / deepseek-chat
  enabled           Boolean   @default(true)
  createdById       String    // 配置者 userId（审计）
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// AI 每周总结配置（用户级，每人一条）。
// 成员只需选择：是否启用、周几发送、几点发、发哪些渠道、是否自定义提示词。
// LLM 由 workspace owner 统一配置，成员不需要也不能看到 API Key。
model AiSummaryConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  // 发送渠道：email / webhook，可多选，至少一个
  channels  String[] @default(["email"])
  weekday   Int      @default(1) // 0=周日 1=周一 ... 6=周六，默认周一
  time      String   @default("09:00") // HH:MM 24小时制
  prompt    String   @default("") // 自定义提示词，留空用系统默认
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== M3 附件 ==========

model Attachment {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  noteId       String?
  note         Note?     @relation(fields: [noteId], references: [id], onDelete: SetNull)
  uploadedById String
  /// 同 Note.author：故意不级联。附件可能被多篇笔记引用，
  /// 删除上传者不该把团队还在用的文件一起删掉。见 Note.author 处的说明。
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  filename     String
  mimeType     String
  size         Int
  storagePath  String    // 本地存储相对路径
  // 附件下载签名凭证（256bit 随机 hex）。存在的原因是浏览器 <img> 标签发不出
  // Authorization 头，而下载路由是强制 JWT 鉴权的，正文里的图片必须能匿名加载。
  // 走 ?t= 旁路时响应带 no-referrer，避免凭证经 Referer 外泄。
  shareToken   String    @unique @default(uuid())
  createdAt    DateTime  @default(now())

  @@index([workspaceId])
  @@index([noteId])
}

