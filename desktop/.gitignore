# 依赖与构建产物
node_modules/
dist/
dist-electron/
release/
.electron-cache/

# 日志
*.log
install.log
build-dist*.log
build-sign-check.log
electron-install.log

# 证书与签名凭据 —— 严禁提交
*.pfx
*.p12
*.key
*.cer
*.crt
sign-metadata.json
sign-metadata*.json

# 环境变量文件（可能含签名凭据、NAS 地址）
.env
.env.*
!.env.example

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 上游根 .gitignore 的 build/ 规则会忽略本目录，但这里的 build/ 存放的是
# 构建资源（应用图标、签名钩子），并非构建输出，必须纳入版本控制。
!build/
!build/**
